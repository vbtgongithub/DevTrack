# DevTrack Backend Environment Variables

# Server
PORT=3001
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/devtrack

# JWT - REQUIRED IN PRODUCTION (no dev defaults)
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Platform API Keys (optional - for sync features)
GITHUB_TOKEN=
LEETCODE_SESSION=

# CORS - REQUIRED: Use production frontend URL in production
# Must use HTTPS in production (will throw error otherwise)
CORS_ORIGIN=http://localhost:5173

# Rate Limiting (general endpoints)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Auth Rate Limiting (stricter limits for auth endpoints)
# Prevent brute-force attacks on login/register
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5
AUTH_RATE_LIMIT_MAX_REQUESTS_WINDOW_1H=20