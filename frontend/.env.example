# DevTrack Frontend Environment Variables
# Use this file as a template for your .env files.

# API BASE URL - REQUIRED: The endpoint where your backend API is reachable.
# In production, this should be your backend's public URL (e.g., https://api.devtrack.com/api)
VITE_API_BASE_URL=http://localhost:3001/api

# Clerk Auth
VITE_CLERK_PUBLISHABLE_KEY=
