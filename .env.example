# DevTrack — Production Deployment Configuration Template
# ============================================================================

# 1. SERVER CONFIGURATION
# ----------------------------------------------------------------------------
PORT=3001
NODE_ENV=production
# The public URL of your frontend application for CORS hardening
CORS_ORIGIN=https://devtrack.vercel.app

# 2. DATABASE (MongoDB Atlas recommended for production)
# ----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://admin:secure_password@cluster0.mongodb.net/devtrack

# 3. SECURITY & AUTH (Generate strong secrets using `openssl rand -base64 32`)
# ----------------------------------------------------------------------------
# MUST BE UNIQUE AND LONG IN PRODUCTION
JWT_ACCESS_SECRET=your_production_access_secret_do_not_share
JWT_REFRESH_SECRET=your_production_refresh_secret_do_not_share

# Expiry times (Access: short-lived, Refresh: long-lived)
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# 4. PLATFORM INTEGRATION (Optional but recommended)
# ----------------------------------------------------------------------------
# Used to bypass GitHub API rate limits for profile enrichment
GITHUB_TOKEN=your_github_personal_access_token

# 5. REDIS (BullMQ backend — required for background jobs in production)
# ----------------------------------------------------------------------------
# Local: leave blank (defaults to localhost:6379 with no auth)
# Production: configure with a managed Redis instance (Upstash, Redis Cloud, etc.)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Or use full URL (overrides host/port/password above):
# REDIS_URL=redis://default:xxxx@my-redis-cluster.upstash.io:6379

# 5. FRONTEND CONFIGURATION (For CI/CD injection)
# ----------------------------------------------------------------------------
# This variable is needed by the Vite build process
VITE_API_BASE_URL=https://devtrack-api.railway.app/api
